# Copy missing values into .env.local. Never use NEXT_PUBLIC for a Resend key.
RESEND_API_KEY=
# Raw email address on your verified Resend domain, e.g. orders@yourdomain.com
RESEND_FROM_EMAIL=
# Optional reply-to address
RESEND_REPLY_TO=
# Optional fixed inbox for verified Razorpay TEST receipts. Blank disables those emails.
RESEND_TEST_TO=
# Real storefront origin in production. This is used for email links.
EMAIL_SITE_URL=http://localhost:3000
