# Keep all secret keys server-only. Copy only missing variables into .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_TEST_TO=
EMAIL_SITE_URL=http://localhost:3000
# Use a random secret of at least 32 characters for authenticated scheduled jobs.
CRON_SECRET=
# New booking alerts for the owner. The WhatsApp number includes the country code, e.g. 919876543210.
OWNER_ALERT_EMAIL=
OWNER_ALERT_WHATSAPP=
# Meta WhatsApp Cloud API. Template names must match templates approved in Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_TO=
WHATSAPP_TEMPLATE_CUSTOMER=subscription_started
WHATSAPP_TEMPLATE_OWNER=owner_new_booking
WHATSAPP_TEMPLATE_LANGUAGE=en
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
